<?xml version="1.0" encoding="utf-8"?>
<!-- v214 mali vidžet (1 × 1): znak Arhive, broj podsetnika koji traže pažnju, natpis -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vz_koren"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">
    <FrameLayout
        android:layout_width="58dp"
        android:layout_height="52dp">
        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:contentDescription="Arhiva"
            android:src="@mipmap/ic_launcher" />
        <TextView
            android:id="@+id/vz_broj"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:background="@drawable/vz_broj_crveno"
            android:gravity="center"
            android:minWidth="22dp"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>
    <TextView
        android:id="@+id/vz_ime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:shadowColor="#99000000"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:text="Arhiva"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />
</LinearLayout>
